# =============================================================================
# geo-stack environment configuration
# Copy to .env.local for development, .env.production for production.
# NEVER commit .env.local or .env.production to git.
# =============================================================================

# --- Database ---
POSTGRES_DB=geodata
POSTGRES_USER=geouser
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD   # Required. Min 16 chars in production.

# --- API ---
ENV=local                          # local | cloud | production
LOG_LEVEL=info                     # debug | info | warning | error
CORS_ORIGINS=http://localhost:5173 # Comma-separated. Use your frontend domain in production.
API_RATE_LIMIT=100                 # Requests per minute per IP for analytics endpoints
SHOW_DOCS=true                     # Set false in production to hide /docs

# --- Connection pooling ---
DB_POOL_SIZE=5                     # asyncpg pool size (use 10+ in production)

# --- URLs (set these to your actual deployed URLs in cloud/production mode) ---
PUBLIC_API_URL=http://localhost:8000
PUBLIC_MARTIN_URL=http://localhost:3000
PUBLIC_TITILER_URL=http://localhost:8080

# --- Cloudflare R2 (for GeoParquet + PMTiles storage in cloud/production mode) ---
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=                     # R2 API token Access Key ID
R2_SECRET_KEY=                     # R2 API token Secret Access Key
R2_BUCKET_NAME=geo-data            # Your R2 bucket name
R2_PUBLIC_URL=                     # Optional: public bucket URL for PMTiles

# --- Production domain (Mode 3 only) ---
DOMAIN=yourdomain.com              # Caddy uses this for auto TLS
ACME_EMAIL=you@email.com           # Let's Encrypt email

# --- DuckDB tuning ---
DUCKDB_THREADS=4                   # CPU threads for DuckDB (match container CPU limit)
DUCKDB_MEMORY=512MB                # Memory limit (stay well below container limit)

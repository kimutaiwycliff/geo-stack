# =============================================================================
# Mode 2: Zero-cost cloud environment variables
# =============================================================================
# Copy to .env.cloud and fill in your values.
# NEVER commit .env.cloud — it is in .gitignore via *.env
#
# Load for local integration testing:
#   set -a; source .env.cloud; set +a
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml up
#
# Set these same variables as environment variables in your Render services
# and as Vercel environment variables for the frontend.
# =============================================================================

# --- Supabase (PostGIS) -------------------------------------------------------
# Dashboard → Project Settings → Database → Connection string → URI (pooler)
# Use the POOLER URL (port 6543) not the direct connection (port 5432).
# Pooler is required for Render's free tier which reuses connections.
SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Cloudflare R2 ------------------------------------------------------------
# Dashboard → R2 → Manage R2 API Tokens → Create API Token
# Permissions: Object Read & Write on your bucket
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=geo-data

# Enable public access on the R2 bucket in the Cloudflare dashboard,
# then set the public URL here. MapLibre fetches PMTiles directly from this
# URL with no API key — CORS config in hosting/r2_cors.json must be applied.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Render service URLs (fill in after first deploy) -------------------------
# These appear as PUBLIC_* env vars in the frontend container and as
# Vercel environment variables so the browser knows where to reach each service.
PUBLIC_API_URL=https://geo-api-<hash>.onrender.com
PUBLIC_MARTIN_URL=https://geo-martin-<hash>.onrender.com
PUBLIC_TITILER_URL=https://geo-titiler-<hash>.onrender.com

# CORS: set to your Vercel frontend URL so the FastAPI CORS middleware allows
# browser requests from the frontend domain.
CORS_ORIGINS=https://your-project.vercel.app

# --- Optional: DuckDB tuning --------------------------------------------------
# Keep these conservative on Render free tier (512 MB RAM limit).
DUCKDB_THREADS=2
DUCKDB_MEMORY=256MB

# --- Vercel (set automatically, listed here for reference) --------------------
# PUBLIC_VERCEL_URL is injected by Vercel at build time — no action needed.
# Add PUBLIC_API_URL, PUBLIC_MARTIN_URL, PUBLIC_TITILER_URL, PUBLIC_R2_URL
# to Vercel → Project → Settings → Environment Variables.

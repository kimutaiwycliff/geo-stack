# Development image with watchfiles hot-reload.
# Source is mounted at /app via docker-compose.local.yml volume,
# so file changes on the host trigger immediate reload inside the container.

FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 8000

# --reload-include watches Python files; watchfiles watches the mounted source
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--reload", "--reload-dir", "/app", "--log-level", "debug"]
